[Unit]
Description=Create service-data directories
RequiresMountsFor=/mnt/service-data

[Service]
ExecStartPre=/usr/bin/mountpoint -q /mnt/service-data
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash -c 'mkdir -p /mnt/service-data/syncthing /mnt/service-data/homepage/config && chown core:core /mnt/service-data /mnt/service-data/syncthing /mnt/service-data/homepage /mnt/service-data/homepage/config && chmod 0775 /mnt/service-data /mnt/service-data/syncthing /mnt/service-data/homepage /mnt/service-data/homepage/config'

[Install]
WantedBy=default.target
