[Unit]
StartLimitIntervalSec=300
StartLimitBurst=5
RequiresMountsFor=/mnt/service-data %h/.local/share/containers/storage
Description=walerie codex pet gallery and waler.ie redirect
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=walerie-slop
HealthCmd=curl -fsS --max-time 5 --output /dev/null http://127.0.0.1:8080/
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=30s
Image=docker.io/nginxinc/nginx-unprivileged:alpine
PublishPort=127.0.0.1:8095:8080
Volume=%h/svc/walerie-pet-gallery:/usr/share/nginx/html:ro,Z
Volume=%h/.config/walerie-slop/nginx.conf:/etc/nginx/conf.d/default.conf:ro,Z

[Service]
ExecStartPre=/usr/bin/mountpoint -q /mnt/service-data
ExecStartPre=/usr/bin/mountpoint -q %h/.local/share/containers/storage
Restart=always
RestartSec=30s

[Install]
WantedBy=default.target
