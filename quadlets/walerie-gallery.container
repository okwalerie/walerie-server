[Unit]
StartLimitIntervalSec=300
StartLimitBurst=5
RequiresMountsFor=/mnt/service-data %h/.local/share/containers/storage
Description=Walerie static gallery for gallery.waler.ie
After=local-fs.target network-online.target data-dirs.service
Requires=data-dirs.service
RequiresMountsFor=/mnt/service-data

[Container]
# Environment values provisioned privately; never committed.
EnvironmentFile=%h/.config/walerie-server/secrets/walerie-gallery.env
ContainerName=walerie-gallery
HealthCmd=curl -fsS --max-time 5 --output /dev/null http://127.0.0.1:8080/
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=30s
Image=docker.io/nginxinc/nginx-unprivileged:alpine
PublishPort=127.0.0.1:8092:8080
# Bind the real persistent path (not its home-directory symlink) so SELinux
# relabeling covers gallery files after container recreation.
Volume=/var/mnt/service-data/svc:/srv/svc:ro,z
Volume=/mnt/service-data/gallery/nginx.conf:/etc/nginx/nginx.conf:ro,z

[Service]
ExecStartPre=/usr/bin/mountpoint -q /mnt/service-data
ExecStartPre=/usr/bin/mountpoint -q %h/.local/share/containers/storage
Restart=always
# Avoid exhausting systemd's start limit during transient storage/boot failures.
RestartSec=30s

[Install]
WantedBy=default.target
