# Explorer — gallery web server (podman QUADLET, systemd USER unit).
# Install to: ~/.config/containers/systemd/explorer-gallery.container
# `systemctl --user daemon-reload` generates explorer-gallery.service from this.
#
# Mirrors the existing walerie-gallery.container pattern but fully isolated:
#   - distinct ContainerName + port (127.0.0.1:8093, the existing one is :8092)
#   - serves the Explorer deploy's site_out (read-only) via nginx-unprivileged
#   - a read-only nginx conf drop-in tuned for the unprivileged image (listens :8080)
#
# nginx-unprivileged:alpine runs as a non-root user and serves on 8080 internally;
# the quadlet maps host 127.0.0.1:8093 -> container 8080. cloudflared (separate
# user tunnel) fronts this on explorer.waler.ie.
[Unit]
StartLimitIntervalSec=300
StartLimitBurst=5
RequiresMountsFor=/mnt/service-data %h/.local/share/containers/storage
Description=Explorer gallery (nginx-unprivileged) on 127.0.0.1:8093
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=explorer-gallery
HealthCmd=curl -fsS --max-time 5 --output /dev/null http://127.0.0.1:8080/
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=30s
Image=docker.io/nginxinc/nginx-unprivileged:alpine
# Loopback-only publish; cloudflared reaches it via http://localhost:8093.
PublishPort=127.0.0.1:8093:8080
# Static site (read-only). %h = /var/home/core. :Z relabels for SELinux; ro = read-only.
Volume=%h/svc/explorer/site_out:/usr/share/nginx/html:ro,Z
# Minimal nginx conf drop-in (read-only). Replaces the image's default.conf.
Volume=%h/svc/explorer/systemd/explorer-nginx.conf:/etc/nginx/conf.d/default.conf:ro,Z

[Service]
ExecStartPre=/usr/bin/mountpoint -q /mnt/service-data
ExecStartPre=/usr/bin/mountpoint -q %h/.local/share/containers/storage
Restart=always
RestartSec=30s

[Install]
WantedBy=default.target
