[Unit]
StartLimitIntervalSec=300
StartLimitBurst=5
RequiresMountsFor=/mnt/service-data %h/.local/share/containers/storage
Description=Rama dev ZooKeeper
After=local-fs.target network-online.target
RequiresMountsFor=/mnt/service-data

[Container]
ContainerName=rama-zookeeper
# Actual dev ZooKeeper port is 2000; srvr is enabled whereas ruok is not whitelisted.
HealthCmd=grep -aq rpl.rama.distributed.command.dev_zookeeper /proc/1/cmdline && timeout 5 bash -c 'exec 3<>/dev/tcp/127.0.0.1/2000; printf srvr >&3; grep -q "^Zookeeper version:" <&3'
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=180s
Pod=rama.pod
Image=rama-runtime.build
Volume=/mnt/service-data/rama/rama-1.9.0:/opt/rama:z
Volume=/mnt/service-data/rama/data:/data:z

Exec=/opt/rama/rama devZookeeper

[Service]
ExecStartPre=/usr/bin/mountpoint -q /mnt/service-data
ExecStartPre=/usr/bin/mountpoint -q %h/.local/share/containers/storage
Restart=always
RestartSec=30s
TimeoutStartSec=900

[Install]
WantedBy=default.target
